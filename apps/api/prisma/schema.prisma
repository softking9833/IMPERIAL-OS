// IMPERIAL OS — Foundation data model
// One backend, one identity system, Perspective + Scope kept separate.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scopes               Scope[]
  users                User[]
  campaigns            Campaign[]
  territories          Territory[]
  curricula            Curriculum[]
  lessons              Lesson[]
  dayRates             AssociateDayRate[]
  roleplayRequirements RoleplayRequirement[]
}

model User {
  id             String   @id @default(cuid())
  organisationId String
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           String
  identityState  String   @default("REGISTERED")
  lifecycleState String   @default("ACCOUNT_CREATED")
  isFieldReady   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation         Organisation          @relation(fields: [organisationId], references: [id])
  perspectives         UserPerspective[]
  scopes               UserScope[]
  sessions             SessionContext[]
  dayRates             AssociateDayRate[]
  deployments          Deployment[]
  requirementProgress  RequirementProgress[]
  approvalsGiven       Approval[]            @relation("Approver")
  approvalsReceived    Approval[]            @relation("Subject")
  auditLogs            AuditLog[]
  fieldActivities      FieldActivity[]
  sales                Sale[]
  callbacks            Callback[]
  lessonProgress         LessonProgress[]
  endOfDayReports        EndOfDayReport[]
  roleplaySubmissions    RoleplaySubmission[] @relation("RoleplaySubmitter")
  roleplayReviews        RoleplaySubmission[] @relation("RoleplayReviewer")
}

/// Perspective = operational interface. Kept separate from Scope.
model UserPerspective {
  id         String   @id @default(cuid())
  userId     String
  perspective String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, perspective])
}

model Scope {
  id             String   @id @default(cuid())
  organisationId String
  type           String
  name           String
  parentId       String?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  parent       Scope?       @relation("ScopeTree", fields: [parentId], references: [id])
  children     Scope[]      @relation("ScopeTree")
  users        UserScope[]
}

model UserScope {
  id        String   @id @default(cuid())
  userId    String
  scopeId   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope Scope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeId])
}

/// Active Perspective + Scope for a session (never merged into one setting).
model SessionContext {
  id                 String   @id @default(cuid())
  userId             String
  activePerspective  String
  activeScopeId      String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model Campaign {
  id                    String   @id @default(cuid())
  organisationId        String
  name                  String
  clientName            String?
  status                String   @default("ACTIVE")
  saleValuePence        Int      @default(10000)
  realisedSaleStatuses  String   @default("PAID")
  expectedPaymentDays   Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  territories  Territory[]
  deployments  Deployment[]
  funnelStages FunnelStage[]
  sales        Sale[]
}

model Territory {
  id             String   @id @default(cuid())
  organisationId String
  campaignId     String?
  name           String
  description    String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])
  deployments  Deployment[]
}

model Deployment {
  id          String    @id @default(cuid())
  userId      String
  campaignId  String
  territoryId String
  startDate   DateTime  @default(now())
  endDate     DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id])
  campaign  Campaign  @relation(fields: [campaignId], references: [id])
  territory Territory @relation(fields: [territoryId], references: [id])
}

model Curriculum {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  kind           String   @default("FIELD_READINESS")
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation           @relation(fields: [organisationId], references: [id])
  requirements FieldReadinessRequirement[]
  lessons      Lesson[]
}

model Lesson {
  id             String   @id @default(cuid())
  organisationId String
  curriculumId   String?
  title          String
  contentType    String   @default("LESSON")
  summary        String?
  body           String?
  videoUrl       String?
  quizJson       String?
  sortOrder      Int      @default(0)
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation                @relation(fields: [organisationId], references: [id])
  curriculum   Curriculum?                 @relation(fields: [curriculumId], references: [id])
  requirements FieldReadinessRequirement[]
  progress     LessonProgress[]
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  status      String    @default("NOT_STARTED")
  quizScore   Int?
  quizPassed  Boolean?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model FieldReadinessRequirement {
  id           String   @id @default(cuid())
  curriculumId String
  lessonId     String?
  title        String
  description  String?
  requirementType String @default("LESSON")
  isMandatory  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  curriculum Curriculum            @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  lesson     Lesson?               @relation(fields: [lessonId], references: [id])
  progress   RequirementProgress[]
}

model RequirementProgress {
  id            String   @id @default(cuid())
  userId        String
  requirementId String
  status        String   @default("NOT_STARTED")
  feedback      String?
  completedAt   DateTime?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirement FieldReadinessRequirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([userId, requirementId])
}

model Approval {
  id           String   @id @default(cuid())
  type         String
  subjectUserId String
  approverId   String?
  decision     String   @default("PENDING")
  feedback     String?
  decidedAt    DateTime?
  createdAt    DateTime @default(now())

  subject  User  @relation("Subject", fields: [subjectUserId], references: [id])
  approver User? @relation("Approver", fields: [approverId], references: [id])
}

model AssociateDayRate {
  id             String    @id @default(cuid())
  organisationId String
  userId         String
  dayRatePence   Int
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FunnelStage {
  id         String  @id @default(cuid())
  campaignId String
  name       String
  code       String
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model BusinessRule {
  id             String   @id @default(cuid())
  organisationId String
  key            String
  valueJson      String
  description    String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([organisationId, key])
}

model FieldActivity {
  id           String   @id @default(cuid())
  userId       String
  activityDate DateTime
  doorsKnocked Int      @default(0)
  conversations Int     @default(0)
  notes        String?
  syncStatus   String   @default("SYNCED")
  clientRef    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRef])
}

model Sale {
  id           String   @id @default(cuid())
  userId       String
  campaignId   String
  status       String   @default("RECORDED")
  saleDate     DateTime @default(now())
  valuePence   Int
  notes        String?
  syncStatus   String   @default("SYNCED")
  clientRef    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@unique([userId, clientRef])
}

model Callback {
  id         String    @id @default(cuid())
  userId     String
  scheduledAt DateTime?
  addressNote String?
  status     String    @default("OPEN")
  notes      String?
  syncStatus String    @default("SYNCED")
  clientRef  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRef])
}

model EndOfDayReport {
  id             String   @id @default(cuid())
  userId         String
  reportDate     DateTime
  doorsKnocked   Int      @default(0)
  conversations  Int      @default(0)
  salesCount     Int      @default(0)
  callbacksOpen  Int      @default(0)
  wins           String?
  challenges     String?
  tomorrowFocus  String?
  status         String   @default("SUBMITTED")
  syncStatus     String   @default("SYNCED")
  clientRef      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRef])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metaJson   String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])
}

model RoleplayRequirement {
  id             String   @id @default(cuid())
  organisationId String
  title          String
  brief          String?
  isMandatory    Boolean  @default(true)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation         @relation(fields: [organisationId], references: [id])
  submissions  RoleplaySubmission[]
}

model RoleplaySubmission {
  id            String    @id @default(cuid())
  requirementId String
  userId        String
  content       String
  status        String    @default("SUBMITTED")
  feedback      String?
  reviewerId    String?
  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requirement RoleplayRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  user        User                @relation("RoleplaySubmitter", fields: [userId], references: [id], onDelete: Cascade)
  reviewer    User?               @relation("RoleplayReviewer", fields: [reviewerId], references: [id])
}
